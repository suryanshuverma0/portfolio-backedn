# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------
# Database & cache
# ------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/portfolio
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# JWT — use long random strings, and different ones for each token.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------------------
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=7d

# ------------------------------------------------------------------
# Cloudinary (image uploads)
# ------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Frontend URL — used to build links in password-reset / passkey emails
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Google Sign-In — must match the frontend's VITE_GOOGLE_CLIENT_ID
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------
# Comma-separated list of emails that are granted the admin role
# ------------------------------------------------------------------
ADMIN_EMAILS=you@example.com

# ------------------------------------------------------------------
# WebAuthn / passkeys
# RP_ID must be the bare domain (no scheme or port) the browser is on:
#   localhost in development, suryanshuverma.com.np in production
#   (the apex domain also covers the www subdomain).
# ------------------------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Portfolio CMS

# ------------------------------------------------------------------
# Resend (transactional email) — optional.
# Free key at https://resend.com. Until it's set, password-reset and
# passkey links are logged to the server console instead of emailed.
# ------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
